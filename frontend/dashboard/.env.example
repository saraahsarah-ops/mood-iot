# =============================================================================
# Mood-IoT — Dashboard Médecin (Next.js 14 + NextAuth v5)
# Variables d'environnement pour le DÉVELOPPEMENT LOCAL.
#
# Démarrage :
#   cd frontend/dashboard
#   cp .env.example .env.local      # puis remplir les valeurs ci-dessous
#   npm install
#   npm run dev                     # http://localhost:3000
#
# NB : .env.local est git-ignoré (il contient un secret). Ne JAMAIS le committer.
# =============================================================================

# ── Backend API ──────────────────────────────────────────────────────────────
# Pour développer le dashboard SANS lancer tout le backend en local, on pointe
# vers l'API déjà déployée. Le client Keycloak `dashboard-medecin` autorise
# déjà http://localhost:3000 (redirect + webOrigins + post-logout).
NEXT_PUBLIC_API_URL=https://api.mood-iot.fr/api/v1

# ── NextAuth (Auth.js v5) ────────────────────────────────────────────────────
# Secret qui signe/chiffre le cookie de session. Générer une valeur unique :
#   openssl rand -base64 32
AUTH_SECRET=change-me-openssl-rand-base64-32

# URL publique du dashboard en local. Indispensable : sans ça NextAuth construit
# les redirections à partir du Host (ex. 0.0.0.0:3000) et le login casse.
AUTH_URL=http://localhost:3000
# Autorise NextAuth à faire confiance au Host en dehors de Vercel (obligatoire
# en local et en self-hosting). Sans ça → redirections vers 0.0.0.0.
AUTH_TRUST_HOST=true

# ── Keycloak (provider OIDC — realm `moodiot`) ──────────────────────────────
AUTH_KEYCLOAK_ID=dashboard-medecin
# Secret du client `dashboard-medecin`. NON inclus ici (sensible) : le demander
# à l'équipe ou le récupérer dans le .env.prod du serveur (clé AUTH_KEYCLOAK_SECRET).
AUTH_KEYCLOAK_SECRET=demander-a-l-equipe
# `issuer` : NextAuth découvre les endpoints (authorization, token, end_session)
# via {issuer}/.well-known/openid-configuration. Sans ça → erreur
# « InvalidEndpoints: Provider keycloak is missing both issuer and authorization ».
AUTH_KEYCLOAK_ISSUER=https://auth.mood-iot.fr/realms/moodiot
