{
  "expo": {
    "name": "Mood-IoT Patient",
    "slug": "mood-iot-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mood-iot",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0f7ff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moodiot.patient",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Mood-IoT utilise HealthKit pour suivre votre bien-être (rythme cardiaque, pas, sommeil, oxygène). Vous pouvez révoquer cet accès à tout moment depuis Réglages.",
        "NSHealthUpdateUsageDescription": "Mood-IoT enregistre vos données de bien-être de manière chiffrée et hébergée en France."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0288d1"
      },
      "package": "com.moodiot.patient",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_OXYGEN_SATURATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-asset",
      [
        "react-native-health-connect",
        {
          "package": "com.moodiot.patient"
        }
      ],
      "./plugins/withHealthConnectPermissionUsage"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "auth": {
        "redirectScheme": "mood-iot",
        "discoveryEnv": "EXPO_PUBLIC_KEYCLOAK_DISCOVERY",
        "clientIdEnv": "EXPO_PUBLIC_KEYCLOAK_CLIENT_ID"
      },
      "eas": {
        "projectId": "d9cde624-ef7d-4ed0-bd7a-da86a6b8cb2c"
      }
    }
  }
}
