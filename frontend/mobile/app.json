{
  "expo": {
    "name": "Mood-IoT Patient",
    "slug": "mood-iot-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "mood-iot",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0288d1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moodiot.patient",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Mood-IoT utilise HealthKit pour suivre votre bien-etre.",
        "NSHealthUpdateUsageDescription": "Mood-IoT enregistre vos donnees de sante."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0288d1"
      },
      "package": "com.moodiot.patient",
      "permissions": [
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE_VARIABILITY"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "auth": {
        "redirectScheme": "mood-iot",
        "discoveryEnv": "EXPO_PUBLIC_KEYCLOAK_DISCOVERY",
        "clientIdEnv": "EXPO_PUBLIC_KEYCLOAK_CLIENT_ID"
      },
      "eas": {
        "projectId": "d9cde624-ef7d-4ed0-bd7a-da86a6b8cb2c"
      }
    }
  }
}
