{
  "name": "mood-iot-patient",
  "version": "1.0.0",
  "description": "Application patient Mood-IoT (React Native + Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "test": "jest --coverage"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-auth-session": "~6.0.0",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.0",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-health-connect": "^3.5.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/react": "~18.3.0",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.6",
    "react-test-renderer": "^18.3.1",
    "typescript": "~5.6.0"
  },
  "overrides": {
    "@expo/config-plugins": "~9.0.17"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/services/**/*.ts",
      "src/stores/**/*.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 4,
        "statements": 4
      }
    }
  }
}
