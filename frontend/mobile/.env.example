# =============================================================================
# Mood-IoT — App Patient (Expo / React Native)
# Variables d'environnement pour le DÉVELOPPEMENT.
#
# Démarrage :
#   cd frontend/mobile
#   cp .env.example .env.local      # puis ajuster si besoin
#   npm install
#   npx expo start                  # scanner le QR avec Expo Go sur le téléphone
#
# NB : .env.local est git-ignoré. Le client Keycloak `mobile-app` est PUBLIC
# (PKCE) → aucun secret à mettre ici.
# =============================================================================

# ── Backend déployé (le plus simple : pas besoin de lancer le backend) ───────
EXPO_PUBLIC_API_URL=https://api.mood-iot.fr/api/v1
EXPO_PUBLIC_KEYCLOAK_DISCOVERY=https://auth.mood-iot.fr/realms/moodiot/.well-known/openid-configuration
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=mobile-app

# ── Alternative : backend en local sur le réseau WiFi ────────────────────────
# Remplacer par l'IP LAN de ta machine (ipconfig / ifconfig) — PAS localhost,
# le téléphone doit pouvoir joindre la machine :
#   EXPO_PUBLIC_API_URL=http://192.168.1.25:8010/api/v1
#   EXPO_PUBLIC_KEYCLOAK_DISCOVERY=http://192.168.1.25:8080/realms/moodiot/.well-known/openid-configuration
#
# Émulateur Android (AVD) → l'hôte est 10.0.2.2 :
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8010/api/v1
