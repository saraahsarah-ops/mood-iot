# ============================================================================
# Mood-IoT : Variables d'environnement (copier vers .env)
# ============================================================================

# ── Base de données PostgreSQL 15 ──────────────────────────────────────────
POSTGRES_USER=mood_user
POSTGRES_PASSWORD=mood_secret_2026
POSTGRES_DB=mood_iot
DATABASE_URL=postgresql://mood_user:mood_secret_2026@postgres:5432/mood_iot

# ── Redis 7 (sessions, cache, pub/sub) ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Keycloak (source de vérité d'identité — OIDC) ──────────────────────────
# En local : Keycloak tourne dans docker-compose sur http://keycloak:8080.
# En prod  : https://auth.moodiot.fr sur le cluster OVH HDS.
KEYCLOAK_ISSUER=http://keycloak:8080/realms/moodiot
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/moodiot/protocol/openid-connect/certs
KEYCLOAK_TOKEN_ENDPOINT=http://keycloak:8080/realms/moodiot/protocol/openid-connect/token
KEYCLOAK_AUDIENCE=mobile-app,dashboard-medecin,backend-services
# Compte de service backend pour appeler l'Admin API Keycloak (optionnel)
KEYCLOAK_ADMIN_CLIENT_ID=backend-services
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-keycloak-admin-secret

# ── Bootstrap Keycloak (utilisé uniquement par le service `keycloak` en local) ─
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin

# ── JWT legacy (signature de tokens internes inter-services seulement) ─────
JWT_SECRET_KEY=change-me-in-production-use-secrets-manager
JWT_ALGORITHM=HS256

# ── AWS (LocalStack en dev) ────────────────────────────────────────────────
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# ── ML Scoring ─────────────────────────────────────────────────────────────
SCORING_THRESHOLDS=40/60/80
MODEL_S3_BUCKET=mood-iot-models
# Desactiver XGBoost pour utiliser uniquement le scoring heuristique (mode demo)
SCORING_DISABLE_XGBOOST=false

# ── Notification Service ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_FROM_PHONE=+33xxxxxxxxx
FCM_CREDENTIALS_JSON={}
SES_FROM_EMAIL=noreply@mood-iot.fr
# Resend (alternative gratuite a SES, 100 emails/jour)
RESEND_API_KEY=re_xxxx

# ── Teleconsultation (Jitsi Meet) ──────────────────────────────────────────
JITSI_SERVER_URL=https://meet.jit.si
JITSI_JWT_SECRET=change-me-jitsi-secret
JITSI_APP_ID=mood-iot

# ── Environnement ─────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
