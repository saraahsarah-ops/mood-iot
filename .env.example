# ============================================================================
# Mood-IoT : Variables d'environnement (copier vers .env)
# ============================================================================

# ── Base de données PostgreSQL 15 ──────────────────────────────────────────
POSTGRES_USER=mood_user
POSTGRES_PASSWORD=mood_secret_2026
POSTGRES_DB=mood_iot
DATABASE_URL=postgresql://mood_user:mood_secret_2026@postgres:5432/mood_iot

# ── Redis 7 (sessions, cache, pub/sub) ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Authentication ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-secrets-manager
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── AWS (LocalStack en dev) ────────────────────────────────────────────────
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# ── MQTT (Mosquitto en dev, IoT Core en prod) ─────────────────────────────
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_TOPIC_PREFIX=mood-iot

# ── ML Scoring ─────────────────────────────────────────────────────────────
SCORING_THRESHOLDS=40/60/80
MODEL_S3_BUCKET=mood-iot-models

# ── Notification Service ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_FROM_PHONE=+33xxxxxxxxx
FCM_CREDENTIALS_JSON={}
SES_FROM_EMAIL=noreply@mood-iot.fr

# ── Teleconsultation (Jitsi Meet) ──────────────────────────────────────────
JITSI_SERVER_URL=https://meet.jit.si
JITSI_JWT_SECRET=change-me-jitsi-secret
JITSI_APP_ID=mood-iot

# ── Environnement ─────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
