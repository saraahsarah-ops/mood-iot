# =============================================================================
# Mood-IoT — Variables d'environnement (copier vers .env)
#
# Dev local :
#   cp .env.example .env
#   docker compose up -d
#
# Production OVH HDS :
#   - Toutes les valeurs marquées `change-me-*` DOIVENT être remplacées
#   - Toutes les valeurs sensibles DOIVENT être stockées dans OVH Secret
#     Manager (ou Vault) et injectées via variables d'env Kubernetes
#   - JAMAIS de fichier .env de production committé dans git
# =============================================================================


# ── PostgreSQL 15 ─────────────────────────────────────────────────────────────
# Dev   : container `postgres` de docker-compose
# Prod  : OVH Managed Postgres Essential HDS (≥ 4 vCPU pour 100 patients)
POSTGRES_USER=mood_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=mood_iot
DATABASE_URL=postgresql://mood_user:change-me-postgres-password@postgres:5432/mood_iot


# ── Redis 7 ───────────────────────────────────────────────────────────────────
# Sessions JWKS cache, pub/sub messagerie, queue APScheduler.
# Prod : OVH Managed Redis Essential (≥ 1 GB).
REDIS_URL=redis://redis:6379/0


# ── Keycloak (source de vérité d'identité — OIDC) ───────────────────────────
# Dev  : container `keycloak` local sur http://keycloak:8080.
# Prod : https://auth.moodiot.fr (Helm chart sur OVH Managed K8s HDS).
KEYCLOAK_ISSUER=http://localhost:8080/realms/moodiot
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/moodiot/protocol/openid-connect/certs
KEYCLOAK_TOKEN_ENDPOINT=http://keycloak:8080/realms/moodiot/protocol/openid-connect/token
# Auds acceptées : 'account' (default Keycloak) + clients explicites
KEYCLOAK_AUDIENCE=account,mobile-app,dashboard-medecin,backend-services
# Compte service pour appels Admin API Keycloak.
# PROD : DOIT correspondre au secret régénéré du client `backend-services`
# (Keycloak admin → Clients → backend-services → Credentials → Regenerate).
# Ne JAMAIS laisser le placeholder du realm JSON en production.
KEYCLOAK_ADMIN_CLIENT_ID=backend-services
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-keycloak-admin-secret

# Bootstrap (1er lancement Keycloak local — pas en prod)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin


# ── JWT inter-services (legacy) ──────────────────────────────────────────────
# Signature de tokens internes entre microservices (scoring → notification).
# Doit être ≥ 32 caractères aléatoires. Rotation tous les 90 jours.
JWT_SECRET_KEY=change-me-with-32-random-bytes-min
JWT_ALGORITHM=HS256

# Secret partagé pour les appels inter-services internes (patient → scoring).
# Header X-Internal-Service. Générer : openssl rand -hex 32. Vide = refus.
INTERNAL_SERVICE_SECRET=change-me-internal-service-secret


# ── Object Storage S3-compatible ─────────────────────────────────────────────
# Dev   : LocalStack (S3 émulé).
# Prod  : OVH Object Storage HDS (région GRA, eu-west-rbx, ou WAR pour HDS).
#         L'endpoint est S3-compatible : https://s3.gra.cloud.ovh.net
OBJECT_STORAGE_ENDPOINT=http://localstack:4566
OBJECT_STORAGE_REGION=eu-west-3
OBJECT_STORAGE_KEY=test
OBJECT_STORAGE_SECRET=test
OBJECT_STORAGE_BUCKET=mood-iot-data
OBJECT_STORAGE_AUDIO_PREFIX=humeur-voix/
OBJECT_STORAGE_MODEL_PREFIX=ml-models/


# ── ML Scoring ───────────────────────────────────────────────────────────────
SCORING_THRESHOLDS=40/60/80
# Désactiver XGBoost pour mode démo (fallback heuristique)
SCORING_DISABLE_XGBOOST=false


# ── Anthropic (Claude Haiku 4.5 — coaching IA & humeur voix) ────────────────
ANTHROPIC_API_KEY=sk-ant-change-me
# Ceinture de sécurité : si le risque dépasse ce seuil, l'IA ne suggère rien
# et un message d'urgence est affiché à la place. Voir backend/src/notification/ai_coach.py
AI_COACHING_RISK_CEILING=80


# ── OpenAI (Whisper API pour transcription voix) ────────────────────────────
# Alternative : whisper.cpp self-hosted sur le cluster (latence + coût ↑)
OPENAI_API_KEY=sk-change-me


# ── Email transactionnel (Resend) ───────────────────────────────────────────
# Domaine vérifié obligatoire : mood-iot.fr (DKIM + DMARC en prod)
# Sert aussi de SMTP pour Keycloak (password reset + email verify).
RESEND_API_KEY=re_change-me
SES_FROM_EMAIL=info@mood-iot.fr


# ── SMS (Twilio — rappels RDV uniquement) ───────────────────────────────────
# En cible HDS, migrer vers OVH SMS (souveraineté FR).
TWILIO_ACCOUNT_SID=AC_change-me
# Option 1 (recommandé) : API Key révocable. Si renseignée, prioritaire.
TWILIO_API_KEY_SID=SK_change-me
TWILIO_API_KEY_SECRET=change-me
# Option 2 (fallback) : Auth Token primaire du compte.
TWILIO_AUTH_TOKEN=change-me
TWILIO_FROM_PHONE=+33xxxxxxxxx
# Data residency : compte Irlande → region=ie1, edge=dublin. Vide pour US1 global.
TWILIO_REGION=
TWILIO_EDGE=


# ── Push notifications (Firebase Cloud Messaging via Expo) ──────────────────
# JSON de la clé de service Firebase Admin SDK (1 ligne, sans saut de ligne).
FCM_CREDENTIALS_JSON={}


# ── Téléconsultation (Jitsi Meet) ───────────────────────────────────────────
JITSI_SERVER_URL=https://meet.jit.si
JITSI_JWT_SECRET=change-me-jitsi-secret
JITSI_APP_ID=mood-iot


# ── Chiffrement données au repos (Fernet) ───────────────────────────────────
# Génération : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation : tous les 12 mois. Conservation des anciennes clés pour déchiffrement.
ENCRYPTION_KEY=change-me-fernet-32-byte-base64-key


# ── Environnement ───────────────────────────────────────────────────────────
# 'development' | 'staging' | 'production'
# CORS : origines autorisées (virgules). En prod, domaines réels, jamais "*".
ALLOWED_ORIGINS=*

ENVIRONMENT=development
LOG_LEVEL=DEBUG
# Force le logging JSON structuré (obligatoire en prod pour SIEM HDS)
STRUCTLOG_JSON=false


# ── Observabilité (prod uniquement) ─────────────────────────────────────────
# OpenTelemetry → OVH Observability ou Grafana Cloud
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mood-iot
# Sentry pour les erreurs applicatives
SENTRY_DSN=

# ── Dashboard médecin (NextAuth v5 + Keycloak) ──────────────────────────────
# AUTH_SECRET : openssl rand -base64 32
AUTH_SECRET=change-me-nextauth-secret-32b
# PROD : DOIT correspondre au secret régénéré du client `dashboard-medecin`
# (Keycloak admin → Clients → dashboard-medecin → Credentials → Regenerate).
# Ne JAMAIS laisser le placeholder du realm JSON en production.
AUTH_KEYCLOAK_SECRET=change-me-keycloak-dashboard-secret
